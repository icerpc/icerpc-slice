[cs::identifier("ZeroC.Slice.Codec")]
module WellKnownTypes

/// Represents a Universally unique identifier (UUID), encoded as 16 bytes (128-bit) in the network byte order
/// specified by RFC 9562 (https://www.rfc-editor.org/rfc/rfc9562#section-4): each field is encoded with its most
/// significant byte first.
[cs::type("System.Guid")]
custom Uuid
